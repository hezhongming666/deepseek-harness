{
  "name": "@deepseek-ai/dsh-tool-ia",
  "description": "Model-facing industrial-automation tools: ia_verify, ia_trace, ia_gate, ia_knowledge, and ia_project over the verifier, trace, gate, knowledge, and orchestrator services",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
